%pal nprocs 20 end

!PBE0 def2-TZVP def2-TZVP/J RIJCOSX Grid5 FinalGrid6 TightSCF

#
* xyzfile 0 1 16459.xyz

#%moinp "604a-pbed3-svp-opt-lrtddft.gbw"

%tddft
  #TDA false
  nroots 50   # Setting the number of roots (transitions) to be calculated.
  maxdim 250 # Setting the maximum dimension of the expansion space. Should be 5-10 times the no. of nroots for favorable convergence.
  end
